  <message>Start action : psScript = 
Add-Type @&amp;apos;
using System;
using System.Runtime.InteropServices;

public class WindowCapture {

    [DllImport(&amp;quot;user32.dll&amp;quot;)]
    public static extern bool PrintWindow(
        IntPtr hwnd,
        IntPtr hdcBlt,
        uint nFlags
    );

    [DllImport(&amp;quot;user32.dll&amp;quot;)]
    public static extern bool GetWindowRect(
        IntPtr hwnd,
        out RECT rect
    );

    [StructLayout(LayoutKind.Sequential)]
    public struct RECT {
        public int Left;
        public int Top;
        public int Right;
        public int Bottom;
    }
}
&amp;apos;@

$fileName = &amp;apos;$excelFileNameForPS&amp;apos;

$app = Get-Process | Where-Object {
    $_.MainWindowHandle -ne 0 -and
    (
        $_.MainWindowTitle -like &amp;quot;*$fileName*&amp;quot; -or
        $_.MainWindowTitle -like &amp;quot;*WPS*&amp;quot; -or
        $_.MainWindowTitle -like &amp;quot;*Excel*&amp;quot;
    )
} | Select-Object -First 1

if ($app) {
    Write-Output $app.MainWindowHandle
    Write-Output $app.MainWindowTitle
}
</message>
