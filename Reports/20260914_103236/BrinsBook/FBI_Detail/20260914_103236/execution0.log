  <thread>1</thread>
  <message>Start action : captureScript = 
Add-Type -AssemblyName System.Drawing

Add-Type @&amp;apos;
using System;
using System.Runtime.InteropServices;

public class CaptureWindow {

    [DllImport(&amp;quot;user32.dll&amp;quot;)]
    public static extern bool GetWindowRect(
        IntPtr hWnd,
        out RECT lpRect
    );

    [DllImport(&amp;quot;user32.dll&amp;quot;)]
    public static extern bool PrintWindow(
        IntPtr hWnd,
        IntPtr hdcBlt,
        uint nFlags
    );

    [StructLayout(LayoutKind.Sequential)]
    public struct RECT {
        public int Left;
        public int Top;
        public int Right;
        public int Bottom;
    }
}
&amp;apos;@

$hwnd = [IntPtr]::new($hwnd)

$rect = New-Object CaptureWindow+RECT

[CaptureWindow]::GetWindowRect(
    $hwnd,
    [ref]$rect
)

$width =
    $rect.Right - $rect.Left

$height =
    $rect.Bottom - $rect.Top

if ($width -le 0 -or $height -le 0) {
    throw &amp;quot;Ukuran window WPS tidak valid: $width x $height&amp;quot;
}

$bitmap =
    New-Object System.Drawing.Bitmap(
        $width,
        $height
    )

$graphics =
    [System.Drawing.Graphics]::FromImage($bitmap)

$hdc =
    $graphics.GetHdc()

$result =
    [CaptureWindow]::PrintWindow(
        $hwnd,
        $hdc,
        2
    )

$graphics.ReleaseHdc($hdc)
$graphics.Dispose()

if (-not $result) {
    throw &amp;quot;PrintWindow gagal mengambil window WPS/Excel.&amp;quot;
}

$bitmap.Save(
    &amp;apos;$screenshotExcel.replace(&amp;apos;, &amp;apos;&amp;apos;)&amp;apos;,
    [System.Drawing.Imaging.ImageFormat]::Png
)

$bitmap.Dispose()

Write-Output &amp;quot;SCREENSHOT_OK&amp;quot;
</message>
