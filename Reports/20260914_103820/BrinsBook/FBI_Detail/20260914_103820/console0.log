Add-Type -AssemblyName System.Drawing

Add-Type @'
using System;
using System.Runtime.InteropServices;

public class CaptureWindow {

    [DllImport("user32.dll")]
    public static extern bool GetWindowRect(
        IntPtr hWnd,
        out RECT lpRect
    );

    [DllImport("user32.dll")]
    public static extern bool PrintWindow(
        IntPtr hWnd,
        IntPtr hdcBlt,
        uint nFlags
    );

    [StructLayout(LayoutKind.Sequential)]
    public struct RECT {
        public int Left;
        public int Top;
        public int Right;
        public int Bottom;
    }
}
'@

$hwnd = [IntPtr]::new($hwnd)

$rect = New-Object CaptureWindow+RECT

[CaptureWindow]::GetWindowRect(
    $hwnd,
    [ref]$rect
)

$width =
    $rect.Right - $rect.Left

$height =
    $rect.Bottom - $rect.Top

if ($width -le 0 -or $height -le 0) {
    throw "Ukuran window WPS tidak valid: $width x $height"
}

$bitmap =
    New-Object System.Drawing.Bitmap(
        $width,
        $height
    )

$graphics =
    [System.Drawing.Graphics]::FromImage($bitmap)

$hdc =
    $graphics.GetHdc()

$result =
    [CaptureWindow]::PrintWindow(
        $hwnd,
        $hdc,
        2
    )

$graphics.ReleaseHdc($hdc)
$graphics.Dispose()

if (-not $result) {
    throw "PrintWindow gagal mengambil window WPS/Excel."
}

$bitmap.Save(
    '$screenshotExcel.replace(', '')',
    [System.Drawing.Imaging.ImageFormat]::Png
)

$bitmap.Dispose()

Write-Output "SCREENSHOT_OK"

