Add-Type @'
using System;
using System.Runtime.InteropServices;

public class WindowCapture {

    [DllImport("user32.dll")]
    public static extern bool PrintWindow(
        IntPtr hwnd,
        IntPtr hdcBlt,
        uint nFlags
    );

    [DllImport("user32.dll")]
    public static extern bool GetWindowRect(
        IntPtr hwnd,
        out RECT rect
    );

    [StructLayout(LayoutKind.Sequential)]
    public struct RECT {
        public int Left;
        public int Top;
        public int Right;
        public int Bottom;
    }
}
'@

$fileName = '$excelFileNameForPS'

$app = Get-Process | Where-Object {
    $_.MainWindowHandle -ne 0 -and
    (
        $_.MainWindowTitle -like "*$fileName*" -or
        $_.MainWindowTitle -like "*WPS*" -or
        $_.MainWindowTitle -like "*Excel*"
    )
} | Select-Object -First 1

if ($app) {
    Write-Output $app.MainWindowHandle
    Write-Output $app.MainWindowTitle
}

